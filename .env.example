# ── Backend / MySQL ─────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env (ที่ root ของโปรเจกต์) แล้วใส่ค่าจริง — ห้าม commit .env เข้า git
# ใช้ฐานข้อมูล "ใหม่" ของโปรเจกต์นี้ (ตารางมีโครงสร้างต่างจาก SmashPang เดิม ห้ามชี้ไปที่ DB เดิม)
DB_HOST=127.0.0.1
DB_USER=smashpang
DB_PASSWORD=change-me
DB_NAME=smashpang_multi
DB_PORT=3306
# MySQL บนคลาวด์ที่บังคับ SSL (Aiven ฯลฯ) ตั้งเป็น true
DB_SSL=false

PORT=3001

# ── Auth ────────────────────────────────────────────────────────────────────
# คีย์สำหรับเซ็น token ล็อกอิน (สุ่มยาวๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ถ้าไม่ตั้ง จะสุ่มใหม่ทุกครั้งที่ restart server (ทุกคนต้อง login ใหม่)
TOKEN_SECRET=

# ── บัญชีเจ้าของก๊วน / แอดมินระบบ ───────────────────────────────────────────
# Gmail ที่สมัครแล้ว (และยืนยันอีเมลแล้ว) จะได้เป็น "แอดมินระบบ" เข้า /?admin ได้
ADMIN_EMAIL=
# URL สาธารณะของเว็บ ใช้สร้างลิงก์ยืนยันอีเมล (เช่น https://smashpang.example.com)
APP_URL=http://localhost:3001

# ยืนยันผ่านอีเมล (SMTP) — ไม่ตั้ง = ไม่ส่งจริง; ตอน dev ระบบแสดงลิงก์ยืนยันให้กดในหน้าเว็บแทน
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 และใช้ App Password เป็น SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# origin ของเว็บที่อนุญาตให้เรียก API คั่นด้วย , (ว่าง = อนุญาตทุก origin — ใช้เฉพาะตอน dev)
CORS_ORIGIN=
